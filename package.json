{
  "name": "@gdex/sdk",
  "version": "0.1.0",
  "description": "Official SDK for integrating GDEX.pro trading services into your applications",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "gdex",
    "trading",
    "hyperliquid",
    "defi",
    "perpetuals",
    "copy-trade",
    "sdk"
  ],
  "author": "GemachDAO Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheArcadiaGroup/gdex-sdk"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": ">=0.25.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
